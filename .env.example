NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
EQUORA_ADMIN_EMAILS=
# Optional: comma-separated allowlist for admin access

# Interne Diagnose. In Produktion standardmäßig aus.
# Nur zusammen mit einem Admin-Konto aktivieren.
EQUORA_PERFORMANCE_DIAGNOSTICS=false

# Optionale strukturierte Diagnosezeilen im Serverterminal.
# Wirkt nur bei aktivierter Performance-Diagnose.
EQUORA_PERFORMANCE_LOGS=false

# Versionierter AES-256-GCM-Keyring für Broker-Zugänge. Werte sind Base64 oder
# 64-stelliges Hex. Alte Versionen bis zur kontrollierten Neuverschlüsselung
# behalten; nur die aktive Version wird für neue Verbindungen verwendet.
EQUORA_BROKER_SECRET_KEYS={}
EQUORA_BROKER_SECRET_ACTIVE_KEY_VERSION=

# Nur für bestehende v57.60.1-Verbindungen. Neue Installationen verwenden den
# Keyring oben. Nicht entfernen, solange ein gespeicherter Zugang key_version=v1 hat.
EQUORA_BROKER_SECRET_KEY=

# Separater 32- bis 64-Byte-HMAC-Schlüssel für pseudonyme Brokerkonto-Identität.
EQUORA_BROKER_IDENTITY_KEY=
EQUORA_BROKER_IDENTITY_KEY_VERSION=idv1

# off = keinerlei MEXC-Egress; probe = nur ausdrücklich ausgelöster Read-only-
# Verbindungscheck; capture = zusätzlich autorisierte automatische Rohdatenerfassung.
# Produktion startet immer mit off. Journalimport wird dadurch nicht aktiviert.
EQUORA_MEXC_RUNTIME_MODE=off

# Zufälliger Wert mit mindestens 16 Zeichen. Vercel sendet ihn als Bearer-Token
# an den internen Capture-Endpunkt; niemals als NEXT_PUBLIC_-Variable anlegen.
CRON_SECRET=
EQUORA_MAINTENANCE_SECRET=
